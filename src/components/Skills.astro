---
import { skills } from "../data/skills"
import AngularIcon from "./icons/Angular.astro"
import NgRxIcon from "./icons/Ngrx.astro"
import AngularMaterialIcon from "./icons/Angular-material.astro"
import NodejsIcon from "./icons/Nodejs.astro"
import MysqlIcon from "./icons/Mysql.astro"
import GithubIcon from "./icons/Github.astro"
import PythonIcon from "./icons/Python.astro"
import FlaskIcon from "./icons/Flask.astro"
import MongodbIcon from "./icons/Mongodb.astro"
import IonicIcon from "./icons/Ionic.astro"
import PhpIcon from "./icons/Php.astro"
import Net from "./icons/Net.astro"
import SqlServer from "./icons/SqlServer.astro"
import ReactNativeIcon from "./icons/ReactNative.astro"

const iconMap: Record<string, any> = {
    AngularIcon,
    NgRxIcon,
    AngularMaterialIcon,
    NodejsIcon,
    MysqlIcon,
    GithubIcon,
    PythonIcon,
    FlaskIcon,
    MongodbIcon,
    IonicIcon,
    PhpIcon,
    Net,
    SqlServer,
    ReactNativeIcon,
}
---

<section id="skills">
  <h2 class="text-3xl font-semibold gap-x-3 text-white">
    Skills
  </h2>
  <div class="flex flex-wrap justify-center gap-5 my-10">
    {skills.map(({ name, component }) => {
      const IconComponent = iconMap[component]
      if (!IconComponent) return null
      return (
        <div
          class="flex items-center justify-center w-20 h-20 bg-gray-800 hover:bg-gray-700 rounded-lg shadow-md transition-transform transform hover:scale-110"
          title={name}
        >
          <IconComponent class="w-14 h-14" />
        </div>
      )
    })}
  </div>
</section>
