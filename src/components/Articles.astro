---
import { articles } from "../data/articles"
import AngularIcon from "./icons/Angular.astro"
import AwsIcon from "./icons/Aws.astro"

const iconMap: Record<string, any> = {
    AngularIcon,
    AwsIcon,
}
---

<div id="articulos">
    <h2 class="text-3xl font-semibold text-white">Artículos</h2>

    {
        articles.map((article) => {
            const IconComponent = iconMap[article.icon]
            if (!IconComponent) return null
            return (
            <div class="py-6 w-full flex flex-row gap-10">
                <div class="flex items-start">
                    <IconComponent class="w-12 h-12 sm:w-16 sm:h-16" />
                </div>

                <div class="flex flex-col gap-1">
                    <h3 class="font-bold text-xl sm:text-3xl text-yellow-500">
                        <a
                            href={article.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-yellow-700 transition-colors duration-500"
                        >
                            {article.title}
                        </a>
                    </h3>

                    <p class="text-slate-300 w-full text-sm sm:text-base sm:w-11/12">
                        {article.description}
                    </p>
                </div>
            </div>
            )
        })
    }
</div>