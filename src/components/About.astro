---
import Icons from "./Icons.astro"
import CvDownload from "./icons/CvDownload.astro"
---

<section
    id="inicio"
    class="h-screen flex flex-col justify-center items-center px-4 text-center max-w-3xl mx-auto"
>
    <div class="space-y-4 flex flex-col items-center">
        <h1 class="text-[clamp(2rem,5vw,3.5rem)] font-bold bg-gradient-to-r from-blue-400 via-purple-500 to-pink-500 bg-clip-text text-transparent animate-fade-in">
            Bryan Soria Méndez
        </h1>

        <h2 class="text-[clamp(1.2rem,3vw,2rem)] font-bold bg-gradient-to-r from-red-400 to-red-600 bg-clip-text text-transparent drop-shadow-lg animate-fade-in" style="animation-delay: 0.2s">
            Desarrollador Full Stack — Angular · Ionic · .NET
        </h2>

        <div class="bg-slate-900/70 backdrop-blur-sm p-4 rounded-xl border border-slate-700/50 shadow-md animate-slide-up">
            <p class="text-slate-300 text-[clamp(0.9rem,2vw,1.1rem)] leading-relaxed">
                Ingeniero de software Full Stack enfocado en arquitectura de aplicaciones empresariales ERP y sistemas móviles offline-first. Experiencia desarrollando soluciones con Angular, Ionic, React Native y .NET para entornos agroindustriales, optimizando procesos operativos, disponibilidad de datos y rendimiento en condiciones de conectividad limitada.
            </p>
        </div>

        <Icons
            sectionClass="flex justify-center items-center gap-4 animate-fade-in"
            style="animation-delay: 0.4s"
            iconClass="w-[clamp(1.8rem,4vw,2rem)] h-[clamp(1.8rem,4vw,2rem)] hover:scale-110 transition-transform duration-200"
        />

        <a 
            href="https://drive.google.com/file/d/10QHlfvnCo6WMTY14I1YhzIzaWz40YiPd/view?usp=sharing" 
            target="_blank" 
            rel="noopener noreferrer"
            class="cv-btn flex items-center gap-2 mt-3"
        >
            <CvDownload class="w-5 h-5" />
            Abrir CV
        </a>

    </div>
</section>

<style>
    .cv-btn {
        background: linear-gradient(90deg, #6d28d9, #db2777);
        color: white;
        font-weight: 700;
        padding: 10px 24px;
        border-radius: 9999px;
        text-decoration: none;
        font-size: clamp(0.9rem,2vw,1rem);
        box-shadow: 0 3px 10px rgba(0,0,0,0.4);
        transition: all 0.3s ease;
    }
    .cv-btn:hover {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 5px 16px rgba(0,0,0,0.6);
    }
</style>
