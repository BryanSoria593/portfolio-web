---
import { config } from "../config"
import GithubIcon from "./icons/Github.astro"
import LinkedinIcon from "./icons/Linkedin.astro"
import MediumIcon from "./icons/Medium.astro"
import MailIcon from "./icons/Mail.astro"

const { iconClass, sectionClass } = Astro.props
---

<section class={`${sectionClass}`}>
    <a
        href={config.links.github}
        target="_blank"
        class="github-icon text-slate-200 transition duration-100"
        aria-label="Github"
    >
        <GithubIcon class={`${iconClass}`} />
    </a>

    <a
        href={config.links.linkedin}
        target="_blank"
        class="linkedin-icon text-blue-400"
        aria-label="Linkedin"
    >
        <LinkedinIcon class={`${iconClass}`} />
    </a>

    <a
        href={config.links.medium}
        target="_blank"
        class="mt-1 medium-icon text-green-400"
        aria-label="Medium"
    >
        <MediumIcon class={`${iconClass}`} />
    </a>

    <a
        href={config.links.gmail}
        target="_blank"
        class="mt-1 mail-icon text-red-400"
        aria-label="Mail"
    >
        <MailIcon class={`${iconClass}`} />
    </a>
</section>
