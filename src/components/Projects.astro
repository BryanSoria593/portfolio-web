---
import { projects } from "../data/projects"
import AngularIcon from "./icons/Angular.astro"
import NgRxIcon from "./icons/Ngrx.astro"
import AngularMaterialIcon from "./icons/Angular-material.astro"
import CloudinaryIcon from "./icons/Cloudinary.astro"
import NodejsIcon from "./icons/Nodejs.astro"
import ExpressjsIcon from "./icons/Expressjs.astro"
import MysqlIcon from "./icons/Mysql.astro"
import GithubIcon from "./icons/Github.astro"
import GoToWebIcon from "./icons/GoToWeb.astro"
import PythonIcon from "./icons/Python.astro"
import FlaskIcon from "./icons/Flask.astro"
import MongodbIcon from "./icons/Mongodb.astro"
import ScikitLearnIcon from "./icons/Scikit.astro"
import VmnwareIcon from "./icons/Vmnware.astro"
import ZimbraIcon from "./icons/Zimbra.astro"
import IonicIcon from "./icons/Ionic.astro"
import PhpIcon from "./icons/Php.astro"

const iconMap: Record<string, any> = {
    AngularIcon,
    NgRxIcon,
    AngularMaterialIcon,
    CloudinaryIcon,
    NodejsIcon,
    ExpressjsIcon,
    MysqlIcon,
    GithubIcon,
    GoToWebIcon,
    PythonIcon,
    FlaskIcon,
    MongodbIcon,
    ScikitLearnIcon,
    VmnwareIcon,
    ZimbraIcon,
    IonicIcon,
    PhpIcon,
}

const mappedProjects = projects.map((project) => ({
    ...project,
    techComponents: project.technologies
        .filter((tech) => iconMap[tech.component])
        .map((tech) => ({
            Component: iconMap[tech.component],
            class: tech.class,
        })),
}))
---

<section id="proyectos">
    <h2 class="text-3xl font-semibold gap-x-3 text-black/80 dark:text-white">
        Proyectos
    </h2>
    <div class="flex flex-wrap justify-evenly gap-5 py-14">
        {mappedProjects.map((project) => (
            <article
                class="project w-full flex flex-col h-auto justify-evenly border rounded-3xl p-4 sm:w-2/5 md:w-10/12 lg:w-2/5"
                style="border: 1px solid #303032;"
            >
                <h3 class="text-xl text-center text-slate-300 mb-4">
                    {project.title}
                </h3>

                <picture>
                    <source type="image/avif" srcset={`${project.images.small} 400w, ${project.images.medium} 800w, ${project.images.large} 1200w`} sizes="(max-width:600px) 100vw, 600px" />
                    <img src={project.images.medium} alt={project.title} width="1200" height="800" class="w-full h-60 object-cover rounded-2xl mb-4" loading="lazy" />
                </picture>

                <p class="text-slate-400 mb-2 text-sm">
                    {project.description}
                </p>
                <div class="mb-4">
                    <h5 class="text-slate-300 mb-2">Módulos principales</h5>
                    <ul class="module-list list-disc text-slate-400 text-sm">
                        {project.modules.map((mod) => (
                            <li>{mod}</li>
                        ))}
                    </ul>
                </div>

                <div class="flex flex-row justify-between">
                    <div class="flex items-center flex-wrap h-auto gap-3 w-7/12 sm:w-11/12 lg:w-8/12">
                        {project.techComponents.map(({ Component, class: cls }) => (
                            <Component class={cls} />
                        ))}
                    </div>
                    <div class="sources items-center flex flex-row gap-3">
                        {project.links.github && (
                            <div class="tooltip text-slate-500 icon-resource">
                                <GithubIcon class="w-7 h-7" />
                                <div class="tooltiptext p-2 gap-1 flex flex-row justify-around">
                                    <a class="text-xs text-slate-300" href={project.links.github} target="_blank" aria-label="Link to Github repository">
                                        Frontend
                                    </a>
                                </div>
                            </div>
                        )}
                        {project.links.live && (
                            <a
                                href={project.links.live}
                                target="_blank"
                                class="text-slate-500 icon-resource"
                                aria-label="Link to live demo"
                            >
                                <GoToWebIcon class="w-7 h-7" />
                            </a>
                        )}
                    </div>
                </div>
            </article>
        ))}
    </div>
</section>

<style>
    svg {
        transition: filter 0.2s ease-in-out;
    }

    .module-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        max-height: 7rem;
        padding-left: 0.9rem;
        gap: 0.2rem;
    }

    .sources svg:hover {
        filter: drop-shadow(0 0 5px rgba(185, 179, 179, 0.7));
    }

    .tooltip {
        position: relative;
        display: inline-block;
    }

    .tooltip .tooltiptext {
        background-color: #333;
        visibility: hidden;
        border-radius: 6px;
        position: absolute;
        z-index: 1;
        bottom: 100%;
        left: 52%;
        margin-left: -60px;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .tooltip:hover .tooltiptext {
        visibility: visible;
        opacity: 1;
    }
    .tooltiptext a {
        display: block;
        transition:
            color 0.3s ease,
            text-shadow 0.3s ease;
    }

    .tooltiptext a:hover {
        color: #f7df1e;
        text-shadow: 0 0 10px rgba(255, 255, 236, 0.7);
    }

    .project {
        background: linear-gradient(to bottom, #252636, #202130, #19191c);
    }
</style>
