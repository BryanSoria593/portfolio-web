---
import "../styles/portfolio.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
const pageTitle = `${title} | Bryan Soria`;
const description =
  "Desarrollo de productos web y móviles con impacto medible. Experiencia en digitalización, software empresarial y trazabilidad.";
const siteUrl = "https://basm-web.vercel.app/";
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bryan Soria Méndez",
  url: siteUrl,
  jobTitle: "Desarrollador de productos web y móviles",
  sameAs: [
    "https://github.com/BryanSoria593",
    "https://www.linkedin.com/in/bryan-soriam/",
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta
      property="og:image"
      content={`${siteUrl}assets/img/hero-share-1200x630.svg`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(person)}
    />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem("bryan-portfolio-theme");
        } catch {}
        document.documentElement.dataset.theme =
          theme === "light" || theme === "dark"
            ? theme
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
